{
  "name": "pos-agent-platform",
  "version": "1.0.0",
  "description": "Production-ready Telegram AI Business Agent Platform with POS integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.js --coverage",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit --coverage",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration",
    "test:e2e": "jest --config jest.config.js --testPathPattern=e2e",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "ts-node --transpile-only src/database/bootstrap.ts",
    "db:seed": "ts-node --transpile-only src/database/bootstrap.ts",
    "docker:build": "docker build -t pos-agent .",
    "docker:up": "docker-compose up -d"
  },
  "dependencies": {
    "openai": "^4.20.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "telegraf": "^4.16.3",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "html-pdf": "^3.0.1",
    "exceljs": "^4.4.0",
    "marked": "^12.0.0",
    "dompurify": "^3.1.6",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@types/helmet": "^4.0.0",
    "@types/html-pdf": "^3.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@types/dompurify": "^3.0.5",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "@types/node-cron": "^3.0.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
