# === LOCAL DEVELOPMENT ===
# SQLite is used by default - no DATABASE_URL needed

# === PRODUCTION ===
# PostgreSQL connection string (Render, Supabase, etc.)
# DATABASE_URL=postgresql://user:pass@host:5432/pos_system

# JWT Secret - CHANGE THIS! Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-random-secret-key

# Frontend URL for CORS
FRONTEND_URL=https://your-app.vercel.app

# Environment
NODE_ENV=production

# Telegram soatlik hisobot (ixtiyoriy — bo'lmasa hisobot yuborilmaydi,
# lekin POS agent/.env dagi BOT_TOKEN + OWNER_CHAT_ID avtomatik olinadi)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# HOURLY_REPORT_ENABLED=true
# HOURLY_REPORT_INTERVAL_MS=3600000

# Akkauntlar Telegram boti (hisobot/akkountlar/tahlil buyruqlari)
# ACCOUNTS_BOT_TOKEN=
# ACCOUNTS_CHAT_ID=

